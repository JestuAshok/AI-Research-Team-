# FastAPI Server Configuration
HOST=127.0.0.1
PORT=8000

# LLM Configuration (Groq)
# Get a key at https://console.groq.com/
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Search Configuration (Tavily)
# Get a key at https://tavily.com/
TAVILY_API_KEY=""

# Database Configuration
DATABASE_URL="sqlite:///database/research.db"

# Mode configuration
# If DEMO_MODE is True, the application will simulate agent runs with high-fidelity realistic datasets
# if GROQ_API_KEY and TAVILY_API_KEY are not provided.
DEMO_MODE=True

# Ngrok Public Tunneling Configuration
NGROK_URL=""
NGROK_AUTH_TOKEN=""

